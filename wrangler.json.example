{
  "name": "ios-location-spoofer-web",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-20",
  "kv_namespaces": [
    {
      "binding": "SPOOFER_DATA",
      "id": "REPLACE_WITH_PRODUCTION_KV_ID"
    }
  ],
  "env": {
    "preview": {
      "kv_namespaces": [
        {
          "binding": "SPOOFER_DATA",
          "id": "REPLACE_WITH_PREVIEW_KV_ID"
        }
      ]
    }
  }
}

